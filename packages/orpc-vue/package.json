{
  "name": "orpc-vue",
  "version": "0.13.0",
  "description": "oRPC integration for Vue and Nuxt with TanStack Vue Query composables.",
  "homepage": "https://github.com/IlyaSemenov/rpc-vue/tree/main/packages/orpc-vue#readme",
  "bugs": "https://github.com/IlyaSemenov/rpc-vue/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/rpc-vue.git",
    "directory": "packages/orpc-vue"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "types": "./dist/runtime/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/runtime/client.d.ts",
      "import": "./dist/runtime/client.js"
    },
    "./nuxt": {
      "types": "./dist/runtime/nuxt/runtime.d.ts",
      "import": "./dist/runtime/nuxt/runtime.js"
    },
    "./nuxt/module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./testing": {
      "types": "./dist/runtime/testing.d.ts",
      "import": "./dist/runtime/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test src tests/runtime",
    "test:component": "vitest run --root tests/fixtures/nuxt",
    "test:nuxt": "bun tests/nuxt/run.ts",
    "types": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && nuxt typecheck tests/fixtures/nuxt",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "devalue": "^5.0.0",
    "es-toolkit": "^1.52.0"
  },
  "devDependencies": {
    "@nuxt/cli": "^3.37.0",
    "@nuxt/kit": "^3.14.1592 || ^4.0.1",
    "@nuxt/test-utils": "^4.3.2",
    "@orpc/client": "2.0.0-beta.35",
    "@orpc/server": "2.0.0-beta.35",
    "@orpc/tanstack-query": "2.0.0-beta.35",
    "@rpc-vue/core": "workspace:*",
    "@tanstack/vue-query": "5.102.8",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.14",
    "@vue/server-renderer": "^3.5.0",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.3",
    "nuxt": "^4.5.2",
    "publint": "^0.3.22",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.11",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.14.1592 || ^4.0.1",
    "@orpc/client": "^2.0.0-beta.35",
    "@orpc/tanstack-query": "^2.0.0-beta.35",
    "@tanstack/vue-query": "^5.102.8",
    "nuxt": "^3.14.1592 || ^4.0.1",
    "vitest": "^4.0.0 || ^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
