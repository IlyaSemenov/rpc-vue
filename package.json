{
  "name": "rpc-vue-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "lefthook install",
    "test": "bun run --workspaces --if-present test",
    "test:component": "bun run --workspaces --if-present test:component",
    "test:nuxt": "bun run --workspaces --if-present test:nuxt",
    "types": "bun run --workspaces --if-present types",
    "version-packages": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@ilyasemenov/oxc-config": "^0.1.3",
    "@playwright/test": "1.58.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsdown": "^0.22.14"
  },
  "overrides": {
    "@tanstack/query-core": "5.102.8"
  },
  "packageManager": "bun@1.4.4"
}
